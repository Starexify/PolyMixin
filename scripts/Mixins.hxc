import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.ScriptedModule;
import polymod.hscript._internal.PolymodClassDeclEx;
import hscript.Expr;
import funkin.util.ReflectUtil;
import hscript.Expr.Metadata;

class Mixins extends ScriptedModule {
    public function new() {
        super("Mixins", Math.NEGATIVE_INFINITY);
    }

    override public function onCreate(event:ScriptEvent) {
        new ASTUtil();

        applyMixins(ModuleHandler.getModule("Mixins")._asc);
    }

    public static function applyMixins(source:Dynamic):Bool {
        var _c:PolymodClassDeclEx = ReflectUtil.getField(source, "_c");
        if (_c.fields == null) return false;
        for (field in _c.fields) {
            for (meta in field.meta) {
                trace(meta);
                var method = retrieveParams(meta, ["method"]).method;
                trace(method);
            }
        }
        return true;
    }

    public static function retrieveParams(meta:Metadata, ?allowed:Array<String>):Dynamic {
        var result:Dynamic = {};
        for (param in meta.params) {
            switch (param.e) {
                case Expr.EBinop(_, e1, e2):
                    switch (e1.e) {
                        case Expr.EIdent(paramName):
                            if (allowed == null || allowed.contains(paramName)) {
                                var value:Dynamic = null;
                            }
                    }
            }
        }
        return result;
    }

    @:Overwrite(method = "test")
    function testOverwrite() {}
}