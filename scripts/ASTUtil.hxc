import funkin.data.dialogue.ConversationRegistry;
import funkin.data.dialogue.DialogueBoxRegistry;
import funkin.data.dialogue.SpeakerRegistry;
import funkin.data.event.SongEventRegistry;
import funkin.data.freeplay.album.AlbumRegistry;
import funkin.data.freeplay.player.PlayerRegistry;
import funkin.data.freeplay.style.FreeplayStyleRegistry;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.data.song.SongRegistry;
import funkin.data.stage.StageRegistry;
import funkin.data.stickers.StickerRegistry;
import funkin.data.story.level.LevelRegistry;
import funkin.modding.module.ModuleHandler;
import funkin.play.notes.notekind.NoteKindManager;
import funkin.play.song.Song;
import funkin.util.ReflectUtil;
import hscript.Expr;
import polymod.hscript._internal.PolymodScriptClass;

class ASTUtil {
    public static function getFuncCache(instance:Dynamic):Map<String, FunctionDecl> {
        return ReflectUtil.getField(instance, "_cachedFunctionDecls");
    }

    public static function getFields(instance:Dynamic):FieldCache {
        return {
            fields: ReflectUtil.getField(instance, "_c").fields,
            cached: ReflectUtil.getField(instance, "_cachedFieldDecls")
        };
    }

    // PolymodClass Getters
    public static function getScriptedModule(id:String):PolymodScriptClass {
        trace(id);
        if (ModuleHandler.getModule(id) == null) return null;
        return ModuleHandler.getModule(id)._asc;
    }

    public static function getScriptedSong(id:String, params:SongParams):PolymodScriptClass {
        return SongRegistry.instance.fetchEntry(id, params)._asc;
    }

    public static function getScriptedLevel(id:String):PolymodScriptClass {
        return LevelRegistry.instance.fetchEntry(id)._asc;
    }

    public static function getScriptedNoteStyle(id:String):PolymodScriptClass {
        return NoteStyleRegistry.instance.fetchEntry(id)._asc;
    }

    public static function getScriptedPlayer(id:String):PolymodScriptClass {
        return PlayerRegistry.instance.fetchEntry(id)._asc;
    }

    public static function getScriptedConversation(id:String):PolymodScriptClass {
        return ConversationRegistry.instance.fetchEntry(id)._asc;
    }

    public static function getScriptedDialogue(id:String):PolymodScriptClass {
        return DialogueBoxRegistry.instance.fetchEntry(id)._asc;
    }

    public static function getScriptedSpeaker(id:String):PolymodScriptClass {
        return SpeakerRegistry.instance.fetchEntry(id)._asc;
    }

    public static function getScriptedAlbum(id:String):PolymodScriptClass {
        return AlbumRegistry.instance.fetchEntry(id)._asc;
    }

    public static function getScriptedStage(id:String):PolymodScriptClass {
        return StageRegistry.instance.fetchEntry(id)._asc;
    }

    public static function getScriptedSticker(id:String):PolymodScriptClass {
        return StickerRegistry.instance.fetchEntry(id)._asc;
    }

    public static function getScriptedFreeplayStyle(id:String):PolymodScriptClass {
        return FreeplayStyleRegistry.instance.fetchEntry(id)._asc;
    }

    public static function getScriptedSongEvent(id:String):PolymodScriptClass {
        return SongEventRegistry.getEvent(id)._asc;
    }

    public static function getScriptedNoteKind(id:String):PolymodScriptClass {
        return NoteKindManager.getNoteKind(id)._asc;
    }

    /*public static function getScriptedCharacter(id:String) {
        if (CharacterDataParser.characterScriptedClass.get(id) == null) return null;
        else return CharacterDataParser.fetchCharacter(id)._asc;
    }*/
}

typedef FieldCache = {
    var fields:Array<FieldDecl>;
    var cached:Map<String, FieldDecl>;
}