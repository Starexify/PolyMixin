import funkin.modding.module.ModuleHandler;
import polymod.hscript._internal.PolymodScriptClass;

class ASTUtil {
    // instancing bs because for some reason polymod forgets values if they're static functions and hot reloading from Funkin
    static var _instance:ASTUtil;
    public static var instance(get, set):ASTUtil;
    static function set_instance(value:ASTUtil):ASTUtil { return _instance = value; }
    static function get_instance():ASTUtil { return _instance; }

    function new() {
        ASTUtil.instance = this;
    }

    // PolymodClass Getters
    public function getScriptedModule(name:String):PolymodScriptClass {
        if (ModuleHandler.getModule(name) == null) return null;
        return ModuleHandler.getModule(name)._asc;
    }
}