import funkin.modding.module.ScriptedModule;
import funkin.modding.events.ScriptEvent;

class ShenaniganFour extends ScriptedModule {
  override public function onCreate(event:ScriptEvent) {
    var myStructure:User = {x: 12, name: "foo"};
    trace(myStructure);
  }
}

typedef User = {
  x : Int,
  name : String,
  ?phoneNumber : String
}
